<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Bandroom own coach runner — launchd template (macOS).
  Install to ~/Library/LaunchAgents/com.bandroom.coach-runner.plist and load:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.bandroom.coach-runner.plist
  Phase 0: the runner stays running (`--daemon`, polls every 2-10 s) and exits
  cleanly after 6 h / 200 tasks; KeepAlive restarts it with fresh config and
  credentials. The orchestrator flock keeps it single-instance. To roll back to
  the 5-minute cadence, replace `--daemon` with `--once`, remove KeepAlive and
  restore StartInterval 300.
  Replace /opt/bandroom/repo and the credentials.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bandroom.coach-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . /etc/bandroom/coach-runner.env; set +a; exec /usr/bin/python3 -m runner.orchestrator --config /opt/bandroom/repo/runner/config.toml --daemon</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/opt/bandroom/repo</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Back-off between restarts (auth failures already wait 300 s in-process). -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/tmp/bandroom-coach-runner.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/bandroom-coach-runner.err</string>
</dict>
</plist>