# Bandroom own coach runner — systemd service template (Linux).
# Install to /etc/systemd/system/bandroom-coach-runner.service together with
# bandroom-coach-runner.timer. The orchestrator flock remains the final
# single-instance guard; Type=oneshot prevents two timer starts overlapping.
[Unit]
Description=Bandroom own coach runner (production coach track)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/bandroom/repo
# Root-owned 0600 file with BANDROOM_RUNNER_CLIENT_ID,
# BANDROOM_RUNNER_CLIENT_SECRET and DASHSCOPE_API_KEY. Never inline secrets.
EnvironmentFile=/etc/bandroom/coach-runner.env
ExecStart=/usr/bin/python3 -m runner.orchestrator --config /opt/bandroom/repo/runner/config.toml
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/bandroom-runner /var/log/bandroom
StateDirectory=bandroom-runner
LogsDirectory=bandroom
StandardOutput=append:/var/log/bandroom/coach-runner.log
StandardError=append:/var/log/bandroom/coach-runner.log