# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Self-hosted hosting override (BANDROOM_HOSTING_CONFIG); keep the example.
/.openai/hosting.own.json

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Analysis bundle outputs
/analysis/bundle/
/analysis/.venv/
__pycache__/

# Claude workspace scaffolding
/.claude/

# Deployment-specific runner configs/scripts (generated from config.example.toml;
# secrets live in ~/.config/bandroom, never in the repo)
/runner/config.qa.toml
/runner/config.prod.toml
/runner/run-prod.sh

# Generated gate evaluation output (any cwd, incl. repo root)
V3_GATE_RESULT.json
v3_export_*.json
/analysis/scripts/calibration-gates/V3_GATE_RESULT.json
/analysis/scripts/calibration-gates/v3_export_*.json

# Local acceptance evidence packs (NC-corpus eval data + raw model responses;
# kept private in the workspace, never published to the public repo)
/acceptance-*/
